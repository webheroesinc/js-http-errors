{
  "name": "@whi/http-errors",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/index.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "author": "Matthew Brisebois",
  "license": "LGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webheroesinc/js-http-errors.git"
  },
  "description": "HTTP error classes with Response conversion utilities",
  "keywords": [
    "http",
    "errors",
    "http-errors",
    "response"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.13",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.3",
    "vitest": "^4.0.13"
  }
}
